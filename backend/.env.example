# -----------------------------------------------------------------------------
# Backend-only secrets and config. Copy this file to "backend/.env" for local dev.
# NEVER put any of these in the project-root .env — that file is bundled into
# the Flutter app binary (see pubspec.yaml `assets: - .env`) and is
# extractable from any compiled APK/IPA. This file is only ever read by the
# FastAPI process (backend/app/config.py — env_file = ".env", scoped to this
# directory only), never packaged into the mobile app.
# Already gitignored via the repo's blanket ".env" rule — never commit it.
# In production (Cloud Run), set these as real environment variables /
# Secret Manager references instead of shipping a .env file.
# -----------------------------------------------------------------------------

# Server bind config
API_HOST=0.0.0.0
API_PORT=8000

# MongoDB Atlas connection string (includes embedded credentials — treat as
# highly sensitive). Cluster → Connect → Drivers → copy the SRV string.
MONGODB_URL=mongodb+srv://user:password@cluster.mongodb.net/myfoodrx

# JWT signing key. Generate with: openssl rand -hex 32
# Rotating this invalidates all currently-issued access tokens (max 1h
# lifetime) but NOT refresh tokens, which are opaque random values stored
# hashed in MongoDB, not signed by this key — clients silently re-mint a new
# access token on their next refresh, no forced logout.
SECRET_KEY=your-secret-key-at-least-32-characters-long

# Shared secret required in the X-Reset-Secret header by POST
# /trackers/reset/daily and /trackers/reset/weekly (called by Cloud
# Scheduler). Leave unset to disable those endpoints (they 501 without it).
TRACKER_RESET_SECRET=your-long-random-secret

# Not currently read by any code in this repo (checked at last audit) — set
# only if something outside this repo depends on it; otherwise leave unset.
ADMIN_PASSWORD=your-admin-password

# LLM API keys (RAG chatbot)
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here # required for LLM-as-judge RAG evaluation

# Firebase Admin config for FCM push notifications.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Prefer FIREBASE_SERVICE_ACCOUNT_B64 in production (base64-encoded service
# account JSON as a single env var); FIREBASE_SERVICE_ACCOUNT_JSON and the
# legacy _BASE64 name also work — see backend/app/config.py.
# FIREBASE_SERVICE_ACCOUNT_B64=

# Android App Links / iOS Universal Links for the password-reset deep link
# (see /.well-known/assetlinks.json and /.well-known/apple-app-site-association
# in app/main.py). Not secrets, but leave unset until you have real values —
# the endpoints safely no-op (App Link verification just doesn't activate;
# the existing foodrx:// custom-scheme flow keeps working) until then.
#
# Android: keytool -list -v -keystore <your-release-keystore> | grep SHA256
# (or, if using Play App Signing, Play Console -> Setup -> App integrity ->
# App signing key certificate -> SHA-256). Comma-separate multiple certs.
ANDROID_SHA256_CERT_FINGERPRINTS=
# Apple: developer.apple.com -> Account -> Membership details -> Team ID.
APPLE_TEAM_ID=

# Gmail SMTP — used to send password-reset emails server-side.
# Generate an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the Gmail account).
GMAIL_USER=your-app-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
EMAIL_FROM_NAME=MyFoodRx

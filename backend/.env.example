# -----------------------------------------------------------------------------
# Backend-only secrets and config. Copy this file to "backend/.env" for local dev.
# NEVER put backend secrets in the project-root .env — that one is bundled
# into the Flutter app (pubspec.yaml assets) and extractable from any
# compiled APK/IPA. This file is read only by the FastAPI backend
# (app/config.py) and is gitignored — never commit it.
# In production (Cloud Run), set these as real environment variables /
# Secret Manager references instead of shipping a .env file.
# -----------------------------------------------------------------------------

# Server bind config
API_HOST=0.0.0.0
API_PORT=8000

# Canonical origin for emailed links (e.g. password reset) — deliberately
# not the request's Host header (unvalidated). Not a secret; override for local dev.
PUBLIC_BASE_URL=https://your-api-host.example.com

# MongoDB Atlas connection string. Contains database credentials — treat as
# highly sensitive. Cluster → Connect → Drivers → copy the SRV string.
MONGODB_URL=mongodb+srv://user:password@cluster.mongodb.net/myfoodrx

# JWT signing key. Generate with: openssl rand -hex 32
# Rotating this invalidates currently-issued access tokens (max 1h lifetime).
# Refresh tokens are opaque random values stored hashed in MongoDB, so
# rotating this key does not invalidate them (no forced logout).
SECRET_KEY=your-secret-key-at-least-32-characters-long

# Shared secret required in the X-Reset-Secret header by POST
# /trackers/reset/daily and /trackers/reset/weekly. Leave unset to disable
# those endpoints (they 501 without it).
TRACKER_RESET_SECRET=your-long-random-secret

# LLM API keys (RAG chatbot). Gemini is the primary model; Groq is the
# fallback when Gemini is exhausted (also used by the eval scripts).
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# Firebase Admin credentials for FCM push notifications.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Prefer FIREBASE_SERVICE_ACCOUNT_B64 (base64-encoded service account JSON).
# FIREBASE_SERVICE_ACCOUNT_JSON and the legacy _BASE64 name also work — see
# app/config.py.
# FIREBASE_SERVICE_ACCOUNT_B64=

# Android App Links / iOS Universal Links for the password-reset deep link
# (see /.well-known/assetlinks.json and /.well-known/apple-app-site-association
# in app/main.py). Not secrets, but leave unset until you have real values —
# the endpoints safely no-op (App Link verification just doesn't activate;
# the existing foodrx:// custom-scheme flow keeps working) until then.
#
# Android: keytool -list -v -keystore <your-release-keystore> | grep SHA256
# (or, for Play App Signing, Play Console -> App integrity -> App signing key
# certificate -> SHA-256 — this is the cert that actually signs the
# Play-distributed build, which can differ from your local keystore).
# Comma-separate multiple certs.
ANDROID_SHA256_CERT_FINGERPRINTS=
# Apple: developer.apple.com -> Account -> Membership details -> Team ID.
APPLE_TEAM_ID=

# Gmail SMTP — used to send password-reset emails server-side.
# Generate an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the Gmail account).
GMAIL_USER=your-app-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
EMAIL_FROM_NAME=MyFoodRx
